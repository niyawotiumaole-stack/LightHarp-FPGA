// PMOD1 exclusively inputs. Remove PMOD LED module before connecting sensors.
// Second axis: R18 = HC-SR04P ECHO (input, pulled down), T18 = TRIG (output).
// `led` is no longer used by harp8x/harp32x.
IO_LOC "clk" V22;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "DAC_BCK" R19;
IO_PORT "DAC_BCK" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "DAC_LRCK" T21;
IO_PORT "DAC_LRCK" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "DAC_DATA" P19;
IO_PORT "DAC_DATA" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "enc_s1" U21;
IO_PORT "enc_s1" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "enc_s2" P16;
IO_PORT "enc_s2" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "enc_key_n" R17;
IO_PORT "enc_key_n" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "test_key_n" AA13;
IO_PORT "test_key_n" IO_TYPE=LVCMOS15 PULL_MODE=UP BANK_VCCIO=1.5;
IO_LOC "echo" R18;
IO_PORT "echo" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
IO_LOC "trig" T18;
IO_PORT "trig" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "sensor_n[0]" AA19;
IO_PORT "sensor_n[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "sensor_n[1]" AB20;
IO_PORT "sensor_n[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "sensor_n[2]" AA20;
IO_PORT "sensor_n[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "sensor_n[3]" AA21;
IO_PORT "sensor_n[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "sensor_n[4]" AB21;
IO_PORT "sensor_n[4]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "sensor_n[5]" AB22;
IO_PORT "sensor_n[5]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "sensor_n[6]" Y21;
IO_PORT "sensor_n[6]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "sensor_n[7]" Y22;
IO_PORT "sensor_n[7]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
// J13 SDRAM0 long header, page19 dock schematic; 3.3V bank3.
IO_LOC "OLED_DIN" E14;
IO_PORT "OLED_DIN" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
IO_LOC "OLED_CLK" E13;
IO_PORT "OLED_CLK" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
IO_LOC "OLED_CS" C15;
IO_PORT "OLED_CS" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
IO_LOC "OLED_DC" C14;
IO_PORT "OLED_DC" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
IO_LOC "OLED_RES" B13;
IO_PORT "OLED_RES" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
